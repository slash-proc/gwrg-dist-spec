{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slash-proc.github.io/gwrg-dist-spec/schema/manifest.schema.json",
  "title": "GWRG dist manifest.json",
  "type": "object",
  "required": ["schemaVersion", "project", "title", "source", "tools", "targets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "docs": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "originalSystem": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "cover": { "$ref": "#/$defs/cover" },
    "storage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["sd", "flash"] }
    },
    "source": {
      "type": "object",
      "required": ["repo", "commit", "ref"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } }
  },
  "$defs": {
    "localised": {
      "type": "object",
      "required": ["en"],
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$" },
      "additionalProperties": { "type": "string" }
    },
    "filename": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\"*/:<>?\\\\|. ](?:[^\\u0000-\\u001f\"*/:<>?\\\\|]*[^\\u0000-\\u001f\"*/:<>?\\\\|. ])?$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requiresAbi": {
      "type": "object",
      "required": ["version", "minSize"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "minSize": { "type": "integer", "minimum": 8 }
      }
    },

    "target": {
      "type": "object",
      "required": ["id", "platform", "label", "kind", "requiresAbi", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "platform": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["homebrew", "core"] },
        "requiresAbi": { "$ref": "#/$defs/requiresAbi" },
        "artifacts": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/artifact" } },
        "uses": { "type": "array", "items": { "$ref": "#/$defs/uses" } },
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbols" } },
        "systems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/system" } },
        "dataDir": { "$ref": "#/$defs/subpath" },
        "runtime": { "$ref": "#/$defs/runtime" }
      }
    },

    "symbols": {
      "type": "object",
      "required": ["filename", "url", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "filename": { "$ref": "#/$defs/filename" },
        "url": { "$ref": "#/$defs/filename" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },

    "extension": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" },

    "subpath": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9 ._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9 ._-]*)*$"
    },

    "system": {
      "type": "object",
      "required": ["id", "longName", "shortName", "extensions", "browse", "compression"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "longName": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/extension" },
              { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/extension" } }
            ]
          }
        },
        "browse": { "enum": ["file", "directory"] },
        "compression": { "type": "boolean" },
        "cheatExt": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
        "biosDir": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "bios": { "type": "array", "items": { "$ref": "#/$defs/bios" } },
        "games": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/game" } },
        "runtime": { "$ref": "#/$defs/runtime" }
      }
    },

    "bios": {
      "type": "object",
      "required": ["id", "filename", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "filename": {
          "anyOf": [
            { "$ref": "#/$defs/filename" },
            { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/filename" } }
          ]
        },
        "required": { "type": "boolean" },
        "requiredFor": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/extension" } },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha1": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "strict": { "type": "boolean" },
        "url": { "$ref": "#/$defs/filename" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "label": { "$ref": "#/$defs/localised" },
        "description": { "$ref": "#/$defs/localised" }
      },
      "dependentRequired": {
        "url": ["bytes", "sha256"]
      }
    },

    "game": {
      "type": "object",
      "required": ["id", "filename", "url", "bytes", "sha256", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "filename": { "$ref": "#/$defs/filename" },
        "url": { "$ref": "#/$defs/filename" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "label": { "$ref": "#/$defs/localised" },
        "description": { "$ref": "#/$defs/localised" }
      }
    },

    "artifact": {
      "type": "object",
      "required": ["filename", "bytes", "sha256", "url"],
      "additionalProperties": false,
      "properties": {
        "filename": { "$ref": "#/$defs/filename" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "url": { "$ref": "#/$defs/filename" },
        "mapped": { "type": "boolean" },
        "relocBase": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },

    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "savestateBytes": { "type": "integer", "minimum": 1 },
        "saveBytes": { "type": "integer", "minimum": 1 }
      }
    },

    "cover": {
      "type": "object",
      "required": ["filename", "bytes", "sha256", "url"],
      "additionalProperties": false,
      "properties": {
        "filename": { "$ref": "#/$defs/filename" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "url": { "$ref": "#/$defs/filename" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },

    "uses": {
      "type": "object",
      "required": ["tool", "outputs", "required"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "system": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },

    "tool": {
      "type": "object",
      "required": ["id", "processor", "title", "binary", "limits", "inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "processor": {
          "type": "object",
          "required": ["type", "version"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["wasm"] },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        "title": { "$ref": "#/$defs/localised" },
        "binary": {
          "type": "object",
          "required": ["file", "url", "bytes", "sha256"],
          "additionalProperties": false,
          "properties": {
            "file": { "$ref": "#/$defs/filename" },
            "url": { "$ref": "#/$defs/filename" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "limits": {
          "type": "object",
          "required": ["maxMemoryPages", "maxOutputBytes"],
          "additionalProperties": false,
          "properties": {
            "maxMemoryPages": { "type": "integer", "minimum": 1 },
            "maxOutputBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } }
      }
    },

    "option": {
      "type": "object",
      "required": ["id", "bit", "default", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bit": { "type": "integer", "minimum": 0, "maximum": 31 },
        "default": { "type": "boolean" },
        "label": { "$ref": "#/$defs/localised" }
      }
    },

    "input": {
      "type": "object",
      "required": ["id", "required", "allowMultiple", "extensions", "maxBytes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "required": { "type": "boolean" },
        "allowMultiple": { "type": "boolean" },
        "runPerFile": { "type": "boolean" },
        "maxCount": { "type": "integer", "minimum": 1 },
        "label": { "$ref": "#/$defs/localised" },
        "description": { "$ref": "#/$defs/localised" },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" } },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "strict": { "type": "boolean" },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } }
      }
    },

    "variant": {
      "type": "object",
      "required": ["id", "sha1"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localised" },
        "sha1": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "filename": { "$ref": "#/$defs/filename" }
      }
    },

    "output": {
      "type": "object",
      "required": ["id", "maxBytes"],
      "oneOf": [
        { "required": ["filename"] },
        { "required": ["extension"] }
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "filename": { "$ref": "#/$defs/filename" },
        "extension": { "$ref": "#/$defs/extension" },
        "subdir": { "$ref": "#/$defs/subpath" },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "label": { "$ref": "#/$defs/localised" },
        "description": { "$ref": "#/$defs/localised" }
      }
    }
  }
}
