{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slash-proc.github.io/gwrg-dist-spec/schema/versions.schema.json",
  "title": "GWRG dist versions.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "title",
    "repo",
    "releasesUrl",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "releasesUrl": {
      "type": "string",
      "format": "uri"
    },
    "retained": {
      "type": "integer",
      "minimum": 1
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": [
        "tag",
        "manifest",
        "publishedAt",
        "prerelease",
        "kind",
        "requiresAbi",
        "needsUserFiles"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "pattern": "^[^/][^:]*$"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "prerelease": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "homebrew",
            "emulator"
          ]
        },
        "requiresAbi": {
          "$ref": "#/$defs/requiresAbi"
        },
        "needsUserFiles": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*-bundle\\.zip$"
        }
      }
    },
    "requiresAbi": {
      "type": "object",
      "required": [
        "version",
        "minSize"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "minSize": {
          "type": "integer",
          "minimum": 8
        }
      }
    }
  }
}
